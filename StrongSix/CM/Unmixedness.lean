import Mathlib
import StrongSix.CM.Unmixed
import StrongSix.CM.Polynomial

/-!
# Macaulay's unmixedness theorem for polynomial rings over a field (M2, layer R3)

This is the one deep input to Roy's proof of the multiplicity estimate (DALAG Ch. 8, Lemma 8.5 and
Thm 8.4). It is assembled from the ported Guan–Hu Cohen–Macaulay library (`StrongSix/CM/*`):
* a field is a Cohen–Macaulay ring (its Krull dimension is `0`);
* `MvPolynomial.isCM_of_isCM`: polynomial rings over a CM ring are CM;
* `isCohenMacaulayRing_iff_unmixed`: in a CM ring, an ideal generated by `r` elements of height `r` is
  unmixed.
-/

open IsLocalRing

/-- A field is a Cohen–Macaulay local ring. -/
instance isCohenMacaulayLocalRing_of_field (K : Type*) [Field K] : IsCohenMacaulayLocalRing K :=
  isCohenMacaulayLocalRing_of_ringKrullDim_le_depth K (by
    rw [ringKrullDim_eq_zero_of_field]
    exact WithBot.coe_le_coe.mpr bot_le)

/-- A field is a Cohen–Macaulay ring. -/
instance isCohenMacaulayRing_of_field (K : Type*) [Field K] : IsCohenMacaulayRing K :=
  IsCohenMacaulayRing.of_isCohenMacaulayLocalRing K

/-- **Macaulay's unmixedness theorem** for `K[X₁, …, Xₙ]`: if the ideal generated by a list of `r`
polynomials has height `r`, then every associated prime of it has height `r`. -/
theorem MvPolynomial.ofList_isUnmixed (K : Type*) [Field K] (n : ℕ)
    (l : List (MvPolynomial (Fin n) K)) (h : (Ideal.ofList l).height = l.length) :
    (Ideal.ofList l).IsUnmixed :=
  (isCohenMacaulayRing_iff_unmixed.mp (MvPolynomial.isCM_of_isCM K n)) l h
